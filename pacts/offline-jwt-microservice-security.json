{
  "consumer": {
    "name": "offline-jwt"
  },
  "interactions": [
    {
      "description": "a fetch of the JWK set",
      "request": {
        "method": "GET",
        "path": "/.well-known/jwks.json"
      },
      "response": {
        "body": {
          "keys": [
            {
              "crv": "Ed25519",
              "kid": "key-1",
              "kty": "OKP",
              "x": "HbFDOOdmqwUJtwEk2uvSiQFBSJlAEojLBuc6IegdA2k"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.keys": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.keys[*].kid": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.keys[*].x": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.17"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "microservice-security"
  }
}
